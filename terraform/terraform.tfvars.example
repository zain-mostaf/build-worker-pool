# Copy to terraform.tfvars and replace the placeholders before running Terraform.
# Keep this file out of version control if it contains credentials.

ibmcloud_api_key         = "<IBM Cloud API key>"
schematics_workspace_id  = "<HPC management Schematics workspace ID>"

# Worker network and sizing
worker_pool_subnet_segmentation = ["10.0.0.0/24"] # Replace with an available worker subnet CIDR
worker_pool_size                 = 1
worker_pool_os                   = "windows"
worker_pool_type                 = "shared"
worker_pool_prefix               = "wf-worker" # Generates wdcaz1-wf-worker-0001 when cluster_prefix is wdcaz1
worker_pool_start_at_number      = 1
worker_private_dns_zone_id       = "<ID of us-east-1.wf.ibmcloud private DNS zone>"
ad_dns_server_ip                 = "<private IPv4 address for wdccom-ad-01.common.wf.ibmcloud>"
ad_domain_name                   = "wf.ibmcloud"
symphony_base_port               = 17869

# Optional: use the parent workspace defaults unless you need overrides.
# worker_pool_subnet_start_host = 64
# symphony_subnet_id             = ""
# symphony_instance_profile      = ""
# symphony_instance_image_id     = ""

# Windows worker options
skip_symphony_config = false

# AD join user/password can come from the parent workspace, or be overridden here.
# Example domain-qualified join account; change to the account permitted to join computers.
ad_join_user     = "wf.ibmcloud\\administrator"
# ad_join_password = "<AD join password>"

# Configure AD DNS to resolve the AD domain and to forward the us-east-1.wf.ibmcloud
# private zone to IBM Cloud DNS. Ensure both private zones permit the worker VPC.
